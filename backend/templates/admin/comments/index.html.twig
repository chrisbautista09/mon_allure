{% extends 'base.html.twig' %}

{% block title %}Commentaires utilisateurs | Mon Allure{% endblock %}

{% block body %}
    <main class="min-h-screen px-4 py-10 text-white sm:px-6">
        <section class="mx-auto max-w-7xl rounded-3xl border border-cyan-300/25 bg-slate-950/80 p-5 shadow-2xl shadow-cyan-950/30 sm:p-8" aria-labelledby="admin-comments-title" data-testid="admin-comments">
            {% include 'admin/_navigation.html.twig' %}
            {% include 'admin/_hero.html.twig' %}

            <header class="mt-6 border-b border-white/10 pb-6">
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-cyan-300">Messages reçus</p>
                <h1 id="admin-comments-title" class="mt-2 text-3xl font-black sm:text-4xl">Commentaires utilisateurs</h1>
                <p class="mt-3 text-white/60">Consultation en lecture seule des 100 derniers commentaires transmis.</p>
            </header>

            {% if comments is empty %}
                <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-white/60">Aucun commentaire reçu.</div>
            {% else %}
                <div class="mt-6 grid gap-4">
                    {% for comment in comments %}
                        <article class="rounded-2xl border border-white/10 bg-blue-950/35 p-5" data-comment-id="{{ comment.id }}">
                            <div class="flex flex-col gap-1 border-b border-white/10 pb-3 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <p class="font-extrabold text-cyan-200">{{ comment.user.pseudo }}</p>
                                    <p class="text-sm text-white/45">{{ comment.user.email }}</p>
                                </div>
                                <time datetime="{{ comment.createdAt|date('c') }}" class="text-sm text-white/50">{{ comment.createdAt|date('d/m/Y à H:i') }}</time>
                            </div>
                            <p class="mt-4 whitespace-pre-line leading-7 text-white/80">{{ comment.content }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
