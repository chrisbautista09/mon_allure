{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord | Mon Allure{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen w-full max-w-6xl px-3 pb-10 text-white sm:px-6" data-testid="user-dashboard">
        <header class="mx-4 mt-8 sm:mx-0">
            <p class="text-sm font-black uppercase tracking-[0.22em] text-cyan-300">Mon Allure Training</p>
            <div class="mt-2 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                    <h1 class="text-3xl font-black sm:text-5xl">Salut {{ app.user.pseudo }}</h1>
                    <p class="mt-2 text-white/60">
                        {% if nextSession %}
                            Prochaine séance le {{ nextSession.date|date('d/m/Y') }} : {{ nextSession.title }}
                        {% else %}
                            Toutes les séances planifiées ont été parcourues.
                        {% endif %}
                    </p>
                </div>
                <a href="{{ path('app_training_weekly') }}" class="inline-flex min-h-11 items-center justify-center rounded-full border border-cyan-300/40 bg-cyan-300/10 px-5 font-bold text-cyan-200 transition hover:-translate-y-0.5 hover:bg-cyan-300 hover:text-slate-950">
                    Voir mon plan détaillé
                </a>
            </div>
        </header>

        {% include 'components/TrainingCard.html.twig' with {
            plan: plan,
            progressPercentage: progressPercentage,
            currentPhase: currentPhase
        } only %}

        {% include 'components/Calendar.html.twig' with {plan: plan} only %}
    </main>
{% endblock %}
