{% extends 'base.html.twig' %}

{% block title %}Mon plan d’entraînement | Mon Allure{% endblock %}

{% set dayNames = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'} %}
{% set sessionIcons = {recovery: '↻', endurance: '🏃', active: '🏃', threshold: '🔥', vma: '⚡', long_run: '⛰'} %}

{% block body %}
    <main class="min-h-screen px-4 py-10 text-white sm:px-6">
        <section class="mx-auto max-w-5xl" aria-labelledby="training-plan-title">
            {% if plan is null %}
                <div class="rounded-3xl border border-cyan-300/30 bg-slate-950/70 p-8 text-center shadow-2xl">
                    <p class="mb-2 text-sm font-bold uppercase tracking-widest text-cyan-300">Mon programme</p>
                    <h1 id="training-plan-title" class="text-3xl font-bold">Aucun plan actif</h1>
                    <p class="mx-auto mt-4 max-w-xl text-white/70">
                        Définissez votre pôle et votre objectif pour générer votre premier programme personnalisé.
                    </p>
                    <a href="{{ path('app_training_goal') }}" class="mt-7 inline-block rounded-full bg-cyan-300 px-7 py-3 font-bold text-slate-950">
                        Définir mon objectif
                    </a>
                </div>
            {% else %}
                <header class="mb-8 rounded-3xl border border-cyan-300/30 bg-slate-950/70 p-6 shadow-2xl sm:p-8">
                    <p class="text-sm font-bold uppercase tracking-widest text-cyan-300">Mon programme</p>
                    <h1 id="training-plan-title" class="mt-2 text-3xl font-bold sm:text-4xl">{{ plan.name }}</h1>
                    <div class="mt-5 flex flex-wrap gap-3 text-sm text-white/80">
                        <span class="rounded-full bg-cyan-300/10 px-4 py-2">Pôle {{ plan.poleType|capitalize }}</span>
                        <span class="rounded-full bg-cyan-300/10 px-4 py-2">{{ plan.durationWeeks }} semaines</span>
                        <span class="rounded-full bg-cyan-300/10 px-4 py-2">Faisabilité : {{ plan.feasibilityIndicator }}</span>
                        <span class="rounded-full bg-cyan-300/10 px-4 py-2">
                            Du {{ plan.startDate|date('d/m/Y') }} au {{ plan.endDate|date('d/m/Y') }}
                        </span>
                    </div>
                </header>

                <div class="space-y-8" data-testid="training-plan-weeks">
                    {% for weekNumber, sessions in weeks %}
                        <section class="rounded-3xl border border-white/10 bg-blue-950/70 p-5 shadow-xl sm:p-7" aria-labelledby="week-{{ weekNumber }}">
                            <h2 id="week-{{ weekNumber }}" class="mb-5 text-2xl font-bold text-cyan-300">Semaine {{ weekNumber }}</h2>

                            <div class="grid gap-4 md:grid-cols-2">
                                {% for session in sessions %}
                                    <article class="rounded-2xl border border-white/10 bg-slate-950/75 p-5" data-session-date="{{ session.date|date('Y-m-d') }}">
                                        <div class="flex items-start justify-between gap-4">
                                            <div>
                                                <p class="font-bold text-cyan-200">
                                                    <span aria-hidden="true">{{ sessionIcons[session.sessionType]|default('🏃') }}</span>
                                                    {{ dayNames[session.dayOfWeek]|default('Jour ' ~ session.dayOfWeek) }}
                                                    <span class="font-normal text-white/55">· {{ session.date|date('d/m') }}</span>
                                                </p>
                                                <h3 class="mt-2 text-xl font-semibold">{{ session.title }}</h3>
                                            </div>
                                            <span class="rounded-full bg-white/10 px-3 py-1 text-xs uppercase tracking-wide text-white/70">{{ session.plannedFcmZone }}</span>
                                        </div>

                                        <dl class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75">
                                            {% if session.plannedDurationMin is not null %}
                                                <div><dt class="sr-only">Durée</dt><dd>{{ session.plannedDurationMin }} min</dd></div>
                                            {% endif %}
                                            {% if session.plannedDistanceKm is not null %}
                                                <div><dt class="sr-only">Distance</dt><dd>{{ session.plannedDistanceKm }} km</dd></div>
                                            {% endif %}
                                            {% if session.plannedVmaCoef is not null %}
                                                <div><dt class="sr-only">VMA</dt><dd>{{ (session.plannedVmaCoef * 100)|round }} % VMA</dd></div>
                                            {% endif %}
                                            {% if session.plannedElevationDPlus is not null %}
                                                <div><dt class="sr-only">Dénivelé</dt><dd>D+ {{ session.plannedElevationDPlus }} m</dd></div>
                                            {% endif %}
                                        </dl>

                                        <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-6 text-white/70">{{ session.description }}</p>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
