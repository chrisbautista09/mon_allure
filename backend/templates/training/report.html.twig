{% extends 'base.html.twig' %}

{% block title %}Mon bilan sportif | Mon Allure{% endblock %}

{% block body %}
    <main class="min-h-screen px-4 py-10 text-white sm:px-6">
        <section class="mx-auto max-w-5xl" aria-labelledby="training-report-title" data-testid="training-report">
            <header class="mb-8 rounded-3xl border border-cyan-300/30 bg-slate-950/70 p-6 shadow-2xl sm:p-8">
                <p class="text-sm font-bold uppercase tracking-widest text-cyan-300">Mon suivi</p>
                <h1 id="training-report-title" class="mt-2 text-3xl font-black sm:text-4xl">Mon bilan sportif</h1>
                <p class="mt-3 text-white/60">Retrouvez votre état de forme, votre évolution, l’équilibre du programme et votre progression.</p>
            </header>

            {% include 'dashboard/_form_status.html.twig' with {formStatus: formStatus} only %}

            {% include 'dashboard/_performance_graphs.html.twig' with {
                statistics: performanceStatistics
            } only %}

            {% include 'dashboard/_intensity_distribution.html.twig' %}

            {% include 'training_plan/_progress.html.twig' with {
                plan: plan,
                progressPercentage: progressPercentage,
                sportsProgress: sportsProgress,
                currentPhase: currentPhase,
                isPlanCompleted: isPlanCompleted
            } only %}
        </section>
    </main>
{% endblock %}
