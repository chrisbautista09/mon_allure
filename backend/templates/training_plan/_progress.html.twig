<section
    class="mb-8 overflow-hidden rounded-3xl border border-cyan-300/30 bg-slate-950/80 shadow-xl shadow-cyan-950/20"
    aria-labelledby="plan-progress-title"
    data-testid="training-plan-progress"
>
    <div class="flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-7">
        <div>
            <p id="plan-progress-title" class="text-xs font-black uppercase tracking-[0.2em] text-cyan-300">
                Votre progression
            </p>
            <p class="mt-2 text-3xl font-black text-white" data-testid="current-week">
                Semaine {{ plan.currentWeek }} <span class="text-white/45">/ {{ plan.durationWeeks }}</span>
            </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-blue-950/60 px-5 py-4 sm:min-w-72">
            <p class="text-xs font-bold uppercase tracking-wider text-white/50">Phase actuelle</p>
            <p class="mt-1 font-bold text-cyan-200" data-testid="current-phase">{{ currentPhase }}</p>
            {% if isPlanCompleted %}
                <p class="mt-2 text-sm font-bold text-emerald-300" data-testid="plan-completed">Plan terminé</p>
            {% endif %}
        </div>

        <div class="grid w-full gap-4 sm:max-w-sm">
            {% include 'components/ProgressBar.html.twig' with {
                progress: progressPercentage,
                label: 'Progression calendrier',
                testId: 'plan-progress'
            } only %}
            {% include 'components/ProgressBar.html.twig' with {
                progress: sportsProgress,
                label: 'Progression sportive',
                testId: 'sports-progress'
            } only %}
        </div>
    </div>
</section>
