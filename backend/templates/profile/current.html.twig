{% extends 'base.html.twig' %}

{% block title %}Mon profil | Mon Allure{% endblock %}

{% block body %}
    <main class="mx-auto min-h-screen w-full max-w-4xl px-4 py-10 text-white sm:px-6">
        <section class="overflow-hidden rounded-3xl border border-cyan-300/25 bg-slate-950/80 p-6 shadow-2xl shadow-cyan-950/30 sm:p-9" aria-labelledby="current-profile-title" data-testid="current-profile">
            <div class="flex flex-col gap-4 border-b border-white/10 pb-7 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-cyan-300">Mes informations</p>
                    <h1 id="current-profile-title" class="mt-2 text-3xl font-black sm:text-4xl">Mon profil complet</h1>
                    <p class="mt-2 text-white/55">Ces informations sont affichées en lecture seule.</p>
                </div>
                <div class="flex size-20 items-center justify-center rounded-full border-2 border-cyan-300 bg-blue-950 text-2xl font-black text-cyan-200 shadow-[0_0_24px_rgba(34,211,238,0.35)]" aria-hidden="true">
                    {{ app.user.pseudo|slice(0, 2)|upper }}
                </div>
            </div>

            {% if profile is null %}
                <div class="mt-7 rounded-2xl border border-white/10 bg-white/5 p-6 text-center">
                    <p class="font-bold text-white/65">Aucun profil complet n’est actuellement associé à votre compte.</p>
                </div>
            {% else %}
                <div class="mt-7 grid gap-6">
                    <section aria-labelledby="identity-title">
                        <h2 id="identity-title" class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">Identité et compte</h2>
                        <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                            {% set identityItems = [
                                {label: 'Prénom', value: profile.firstName},
                                {label: 'Nom', value: profile.lastName},
                                {label: 'Âge', value: profile.age ~ ' ans'},
                                {label: 'Pseudo', value: app.user.pseudo},
                                {label: 'Adresse e-mail', value: app.user.email}
                            ] %}
                            {% for item in identityItems %}
                                <div class="rounded-2xl border border-white/5 bg-white/5 p-4">
                                    <dt class="text-xs font-bold uppercase tracking-wider text-white/40">{{ item.label }}</dt>
                                    <dd class="mt-1 break-words font-extrabold text-white">{{ item.value }}</dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </section>

                    <section aria-labelledby="location-title">
                        <h2 id="location-title" class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">Localisation d’entraînement</h2>
                        <dl class="mt-3 grid gap-3 sm:grid-cols-3">
                            {% set locationItems = [
                                {label: 'Ville', value: profile.city},
                                {label: 'Code postal', value: profile.postalCode},
                                {label: 'Pays', value: profile.country}
                            ] %}
                            {% for item in locationItems %}
                                <div class="rounded-2xl border border-white/5 bg-white/5 p-4">
                                    <dt class="text-xs font-bold uppercase tracking-wider text-white/40">{{ item.label }}</dt>
                                    <dd class="mt-1 font-extrabold text-white">{{ item.value ?? 'Non renseigné' }}</dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </section>

                    <section aria-labelledby="physiology-title">
                        <h2 id="physiology-title" class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">Données physiologiques</h2>
                        <dl class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
                            {% set physiologyItems = [
                                {label: 'VMA', value: profile.vma is not null ? profile.vma|number_format(1, ',', ' ') ~ ' km/h' : null},
                                {label: 'VO₂ max', value: profile.vo2max is not null ? profile.vo2max|number_format(1, ',', ' ') ~ ' ml/min/kg' : null},
                                {label: 'FC maximale', value: profile.fcm is not null ? profile.fcm ~ ' bpm' : null},
                                {label: 'FC au repos', value: profile.fcr is not null ? profile.fcr ~ ' bpm' : null}
                            ] %}
                            {% for item in physiologyItems %}
                                <div class="rounded-2xl border border-cyan-300/10 bg-blue-950/45 p-4">
                                    <dt class="text-xs font-bold uppercase tracking-wider text-white/40">{{ item.label }}</dt>
                                    <dd class="mt-2 text-lg font-black text-cyan-200">{{ item.value ?? 'Non renseigné' }}</dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </section>

                    <p class="text-right text-xs text-white/35">Dernière mise à jour : {{ profile.updatedAt|date('d/m/Y à H:i') }}</p>
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
