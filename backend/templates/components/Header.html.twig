<header class="px-2 pt-2">
    <div class="flex flex-wrap items-center justify-between gap-3">

        <a
            href="{{ path('app_home') }}"
            aria-label="Accueil Mon Allure"
            class="block size-14 shrink-0 overflow-hidden rounded-full shadow-[0_0_14px_rgba(34,211,238,0.65)] transition hover:scale-105 focus:outline-none focus:ring-2 focus:ring-cyan-300"
            data-testid="mon-allure-logo"
        >
            <img
                src="{{ asset('images/logo Mon Allure.png') }}"
                alt="Logo Mon Allure"
                width="75"
                height="75"
                class="size-full object-contain"
            >
        </a>

        <div class="order-2 flex items-center gap-2 sm:order-3">
            <a
                href="{{ app.user ? path('app_current_profile') : path('app_login') }}"
                class="flex items-center gap-2 rounded-full border border-blue-400/30 border-r-cyan-300 bg-slate-800/80 py-1 pr-1 pl-3 shadow-[0_0_12px_rgba(34,211,238,0.18)] backdrop-blur-md transition hover:border-cyan-300"
            >
                <span class="hidden text-xs text-slate-100 lg:inline" data-testid="authenticated-user">
                    {{ app.user ? (app.user.pseudo ?? app.user.userIdentifier) : 'Se connecter' }}
                </span>

                <span class="flex size-9 items-center justify-center overflow-hidden rounded-full border-2 border-cyan-300 bg-slate-950 shadow-[0_0_10px_rgba(34,211,238,0.75)]">
                    <span class="flex size-7 items-center justify-center rounded-full bg-gradient-to-br from-amber-700 via-slate-700 to-slate-950 text-[10px] font-bold text-white">
                        {{ app.user ? app.user.pseudo|slice(0, 2)|upper : 'MA' }}
                    </span>
                </span>
            </a>

        </div>
    </div>

    <p
        class="
            mt-1
            text-center
            text-xs
            font-black
            tracking-[0.18em]
            text-cyan-300
            uppercase
        "
    >
        Mon Allure Training
    </p>
</header>
