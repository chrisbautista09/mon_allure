<section class="training-calendar-section">
    <div class="training-calendar-heading">
        <div>
            <p class="training-calendar-eyebrow">
                Mon programme
            </p>

            <h2 class="training-calendar-title">
                Calendrier d’entraînement
            </h2>
        </div>

        <a
            href="{{ path('app_training_weekly') }}"
            class="training-calendar-week-link"
        >
            Voir ma semaine
        </a>
    </div>

    <p class="training-calendar-help">
        Sélectionne une séance pour afficher son détail ou clique sur une date
        pour consulter la semaine correspondante.
    </p>

    <div
        id="training-calendar"
        class="training-calendar"
        data-events-url="{{ path('app_calendar_events') }}"
        data-weekly-url="{{ path('app_training_weekly') }}"
        data-training-start="2026-07-06"
        data-training-end="2026-09-27"
        data-current-week="3"

    ></div>
</section>